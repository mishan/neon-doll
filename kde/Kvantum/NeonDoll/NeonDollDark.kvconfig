# Neon Doll Dark, for Kvantum. Generated by tools/build-kde.py; edit that, not this.

[%General]
author=Misha Nasledov
comment=Neon Doll Dark: hot pink neon on midnight plum
respect_DE=true
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
composite=false
animate_states=false
no_inactiveness=true
left_tabs=true
attach_active_tab=true
joined_inactive_tabs=true
group_toolbar_buttons=false
merge_menubar_with_toolbar=true
center_toolbar_handle=true
toolbar_separator_thickness=9
spread_progressbar=true
progressbar_thickness=6
spread_menuitems=true
menu_separator_height=9
menu_shadow_depth=0
tooltip_shadow_depth=0
splitter_width=1
scroll_width=10
scroll_min_extent=36
scroll_arrows=false
scrollbar_in_view=true
transient_scrollbar=false
combo_as_lineedit=true
inline_spin_indicators=true
slider_width=4
slider_handle_width=18
slider_handle_length=10
check_size=16
groupbox_top_label=true
tree_branch_line=false
layout_spacing=6
layout_margin=6
dark_titlebar=true

[GeneralColors]
window.color=#0f0d14
base.color=#0f0d14
alt.base.color=#191522
button.color=#191522
light.color=#2a2438
mid.light.color=#2a2438
dark.color=#0f0d14
mid.color=#2a2438
shadow.color=#0f0d14
highlight.color=#57173b
inactive.highlight.color=#29213a
tooltip.base.color=#16131d
text.color=#ebe6f0
window.text.color=#ebe6f0
button.text.color=#ebe6f0
disabled.text.color=#6f6880
tooltip.text.color=#ebe6f0
highlight.text.color=#ebe6f0
link.color=#b48cff
link.visited.color=#b48cff
progress.indicator.text.color=#ebe6f0

[Hacks]
respect_darkness=true
transparent_ktitle_label=true
transparent_menutitle=true
normal_default_pushbutton=true
no_selection_tint=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
interior=true
interior.element=button
focusFrame=true
indicator.element=arrow
indicator.size=10
text.margin.top=3
text.margin.bottom=3
text.margin.left=8
text.margin.right=8
text.iconspacing=6
text.normal.color=#ebe6f0
text.focus.color=#ff2d95
text.press.color=#ff2d95
text.toggle.color=#ff2d95

