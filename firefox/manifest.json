{
  "manifest_version": 2,
  "name": "Neon Doll",
  "version": "0.1.0",
  "description": "A man page in a terminal that never existed: plum, fuchsia for where you are, purple for links. Follows the system's light or dark mode.",
  "homepage_url": "https://github.com/mishan/neon-doll",
  "browser_specific_settings": {
    "gecko": {
      "id": "neon-doll@mishan.github.io"
    }
  },
  "theme": {
    "colors": {
      "frame": "#f7f4fa",
      "frame_inactive": "#f7f4fa",
      "tab_background_text": "#5f5670",
      "tab_background_separator": "#d6cce2",
      "tab_selected": "#ede7f3",
      "tab_text": "#c8006a",
      "tab_line": "#c8006a",
      "tab_loading": "#c8006a",
      "toolbar": "#ede7f3",
      "toolbar_text": "#1a1522",
      "bookmark_text": "#1a1522",
      "icons": "#1a1522",
      "icons_attention": "#c8006a",
      "button_background_hover": "rgba(200, 0, 106, 0.1)",
      "button_background_active": "rgba(200, 0, 106, 0.18)",
      "toolbar_top_separator": "#d6cce2",
      "toolbar_bottom_separator": "#d6cce2",
      "toolbar_vertical_separator": "#d6cce2",
      "toolbar_field": "#f7f4fa",
      "toolbar_field_text": "#1a1522",
      "toolbar_field_border": "#d6cce2",
      "toolbar_field_focus": "#f7f4fa",
      "toolbar_field_text_focus": "#1a1522",
      "toolbar_field_border_focus": "#c8006a",
      "toolbar_field_highlight": "rgba(200, 0, 106, 0.3)",
      "toolbar_field_highlight_text": "#1a1522",
      "popup": "#ede7f3",
      "popup_text": "#1a1522",
      "popup_border": "#d6cce2",
      "popup_highlight": "rgba(200, 0, 106, 0.14)",
      "popup_highlight_text": "#1a1522",
      "sidebar": "#ede7f3",
      "sidebar_text": "#1a1522",
      "sidebar_border": "#d6cce2",
      "sidebar_highlight": "rgba(200, 0, 106, 0.14)",
      "sidebar_highlight_text": "#c8006a",
      "ntp_background": "#f7f4fa",
      "ntp_card_background": "#ede7f3",
      "ntp_text": "#1a1522"
    },
    "images": {
      "additional_backgrounds": [
        "images/paper-light.png"
      ]
    },
    "properties": {
      "additional_backgrounds_alignment": [
        "left top"
      ],
      "additional_backgrounds_tiling": [
        "repeat"
      ],
      "color_scheme": "light",
      "content_color_scheme": "system"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#0f0d14",
      "frame_inactive": "#0f0d14",
      "tab_background_text": "#9c93ab",
      "tab_background_separator": "#2a2438",
      "tab_selected": "#16131d",
      "tab_text": "#ff2d95",
      "tab_line": "#ff2d95",
      "tab_loading": "#ff2d95",
      "toolbar": "#16131d",
      "toolbar_text": "#ebe6f0",
      "bookmark_text": "#ebe6f0",
      "icons": "#ebe6f0",
      "icons_attention": "#ff2d95",
      "button_background_hover": "rgba(255, 45, 149, 0.1)",
      "button_background_active": "rgba(255, 45, 149, 0.18)",
      "toolbar_top_separator": "#2a2438",
      "toolbar_bottom_separator": "#2a2438",
      "toolbar_vertical_separator": "#2a2438",
      "toolbar_field": "#0f0d14",
      "toolbar_field_text": "#ebe6f0",
      "toolbar_field_border": "#2a2438",
      "toolbar_field_focus": "#0f0d14",
      "toolbar_field_text_focus": "#ebe6f0",
      "toolbar_field_border_focus": "#ff2d95",
      "toolbar_field_highlight": "rgba(255, 45, 149, 0.3)",
      "toolbar_field_highlight_text": "#ebe6f0",
      "popup": "#16131d",
      "popup_text": "#ebe6f0",
      "popup_border": "#2a2438",
      "popup_highlight": "rgba(255, 45, 149, 0.14)",
      "popup_highlight_text": "#ebe6f0",
      "sidebar": "#16131d",
      "sidebar_text": "#ebe6f0",
      "sidebar_border": "#2a2438",
      "sidebar_highlight": "rgba(255, 45, 149, 0.14)",
      "sidebar_highlight_text": "#ff2d95",
      "ntp_background": "#0f0d14",
      "ntp_card_background": "#16131d",
      "ntp_text": "#ebe6f0"
    },
    "images": {
      "additional_backgrounds": [
        "images/paper-dark.png"
      ]
    },
    "properties": {
      "additional_backgrounds_alignment": [
        "left top"
      ],
      "additional_backgrounds_tiling": [
        "repeat"
      ],
      "color_scheme": "dark",
      "content_color_scheme": "system"
    }
  }
}
