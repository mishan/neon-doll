  "tokenColors": [
    {
      "name": "Everything else",
      "scope": [
        "source",
        "text",
        "variable",
        "entity.name.function",
        "punctuation",
        "meta.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#1a1522"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5f5670",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "comment storage.type",
        "comment keyword",
        "comment entity.name.type",
        "comment variable",
        "comment punctuation.definition.block.tag",
        "comment punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#6a3fd0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#b80061"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#1a1522"
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.typeid",
        "keyword.operator.cast",
        "keyword.operator.instanceof",
        "keyword.operator.delete",
        "keyword.operator.and",
        "keyword.operator.or",
        "keyword.operator.not",
        "keyword.operator.in",
        "keyword.operator.is",
        "keyword.operator.of"
      ],
      "settings": {
        "foreground": "#b80061"
      }
    },
    {
      "name": "Decorators, macros, preprocessor",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.function.decorator",
        "entity.name.function.macro",
        "support.function.macro",
        "entity.name.function.preprocessor",
        "meta.preprocessor",
        "punctuation.definition.directive",
        "meta.attribute.rust",
        "punctuation.definition.attribute"
      ],
      "settings": {
        "foreground": "#b80061"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#b80061"
      }
    },
    {
      "name": "Numbers, constants, escapes",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.character.escape",
        "constant.other",
        "support.constant",
        "keyword.other.unit",
        "constant.character.format.placeholder",
        "variable.language",
        "variable.parameter.function.language.special",
        "punctuation.definition.template-expression",
        "string.regexp constant.character",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#6a3fd0"
      }
    },
    {
      "name": "Types and builtins",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.struct",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.function",
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.numeric",
        "storage.type.boolean",
        "storage.type.string",
        "storage.type.char",
        "storage.type.java",
        "entity.name.type.lifetime",
        "storage.modifier.lifetime",
        "support.variable",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#6a3fd0"
      }
    },
    {
      "name": "Attributes and keys",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "support.type.property-name.css",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#6a3fd0"
      }
    },
    {
      "name": "Variables with a sigil",
      "scope": [
        "variable.other.php",
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "variable.other.positional.shell",
        "variable.other.bracket.shell",
        "punctuation.definition.variable",
        "variable.other.readwrite.instance.ruby",
        "variable.other.global.perl",
        "variable.other.readwrite.global.perl",
        "variable.other.predefined.perl"
      ],
      "settings": {
        "foreground": "#6a3fd0"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template",
        "string.unquoted",
        "markup.inline.raw.string",
        "storage.type.string.python",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#8a6100"
      }
    },
    {
      "name": "Embedded code is code",
      "scope": [
        "string meta.embedded",
        "string meta.template.expression",
        "meta.fstring.python meta.embedded",
        "string.quoted.docstring punctuation"
      ],
      "settings": {
        "foreground": "#1a1522"
      }
    },
    {
      "name": "Docstrings are comments",
      "scope": [
        "string.quoted.docstring",
        "string.quoted.docstring punctuation.definition.string",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#5f5670",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c4312a",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#5f5670",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#1a1522"
      }
    },
    {
      "name": "Heading marks",
      "scope": [
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#5f5670"
      }
    },
    {
      "name": "Emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strike",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline.markdown string.other.link.title"
      ],
      "settings": {
        "foreground": "#6a3fd0"
      }
    },
    {
      "name": "Link punctuation",
      "scope": [
        "punctuation.definition.link",
        "punctuation.definition.metadata",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#5f5670"
      }
    },
    {
      "name": "Inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#1a1522"
      }
    },
    {
      "name": "Lists and quotes",
      "scope": [
        "punctuation.definition.list",
        "beginning.punctuation.definition.list",
        "markup.quote",
        "punctuation.definition.quote"
      ],
      "settings": {
        "foreground": "#5f5670"
      }
    },
    {
      "name": "Fence language",
      "scope": [
        "fenced_code.block.language"
      ],
      "settings": {
        "foreground": "#5f5670"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#1d7630"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#c4312a"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#8a6100"
      }
    },
    {
      "name": "Hunk header",
      "scope": [
        "meta.diff.range",
        "meta.diff.range punctuation"
      ],
      "settings": {
        "foreground": "#6a3fd0"
      }
    },
    {
      "name": "Diff file",
      "scope": [
        "meta.diff.header",
        "meta.diff.index",
        "meta.separator.diff"
      ],
      "settings": {
        "foreground": "#5f5670"
      }
    },
    {
      "name": "Commit messages",
      "scope": [
        "meta.scope.message.git-commit"
      ],
      "settings": {
        "foreground": "#1a1522"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#b80061",
    "modifier": "#b80061",
    "decorator": "#b80061",
    "macro": "#b80061",
    "comment": {
      "foreground": "#5f5670",
      "italic": true
    },
    "string": "#8a6100",
    "regexp": "#8a6100",
    "number": "#6a3fd0",
    "enumMember": "#6a3fd0",
    "type": "#6a3fd0",
    "class": "#6a3fd0",
    "interface": "#6a3fd0",
    "enum": "#6a3fd0",
    "struct": "#6a3fd0",
    "typeParameter": "#6a3fd0",
    "typeAlias": "#6a3fd0",
    "builtinType": "#6a3fd0",
    "boolean": "#6a3fd0",
    "selfKeyword": "#6a3fd0",
    "lifetime": "#6a3fd0",
    "function.defaultLibrary": "#6a3fd0",
    "variable.defaultLibrary": "#6a3fd0",
    "class.defaultLibrary": "#6a3fd0",
    "namespace.defaultLibrary": "#6a3fd0",
    "namespace": "#1a1522",
    "function": "#1a1522",
    "method": "#1a1522",
    "variable": "#1a1522",
    "variable.readonly": "#1a1522",
    "parameter": "#1a1522",
    "property": "#1a1522",
    "property.readonly": "#1a1522",
    "label": "#1a1522",
    "operator": "#1a1522",
    "event": "#1a1522",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
