  "tokenColors": [
    {
      "name": "Everything else",
      "scope": [
        "source",
        "text",
        "variable",
        "entity.name.function",
        "punctuation",
        "meta.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#ebe6f0"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9c93ab",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "comment storage.type",
        "comment keyword",
        "comment entity.name.type",
        "comment variable",
        "comment punctuation.definition.block.tag",
        "comment punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#b48cff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#ff2d95"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ebe6f0"
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.typeid",
        "keyword.operator.cast",
        "keyword.operator.instanceof",
        "keyword.operator.delete",
        "keyword.operator.and",
        "keyword.operator.or",
        "keyword.operator.not",
        "keyword.operator.in",
        "keyword.operator.is",
        "keyword.operator.of"
      ],
      "settings": {
        "foreground": "#ff2d95"
      }
    },
    {
      "name": "Decorators, macros, preprocessor",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.function.decorator",
        "entity.name.function.macro",
        "support.function.macro",
        "entity.name.function.preprocessor",
        "meta.preprocessor",
        "punctuation.definition.directive",
        "meta.attribute.rust",
        "punctuation.definition.attribute"
      ],
      "settings": {
        "foreground": "#ff2d95"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ff2d95"
      }
    },
    {
      "name": "Numbers, constants, escapes",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.character.escape",
        "constant.other",
        "support.constant",
        "keyword.other.unit",
        "constant.character.format.placeholder",
        "variable.language",
        "variable.parameter.function.language.special",
        "punctuation.definition.template-expression",
        "string.regexp constant.character",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#b48cff"
      }
    },
    {
      "name": "Types and builtins",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.struct",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.function",
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.numeric",
        "storage.type.boolean",
        "storage.type.string",
        "storage.type.char",
        "storage.type.java",
        "entity.name.type.lifetime",
        "storage.modifier.lifetime",
        "support.variable",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#b48cff"
      }
    },
    {
      "name": "Attributes and keys",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "support.type.property-name.css",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#b48cff"
      }
    },
    {
      "name": "Variables with a sigil",
      "scope": [
        "variable.other.php",
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "variable.other.positional.shell",
        "variable.other.bracket.shell",
        "punctuation.definition.variable",
        "variable.other.readwrite.instance.ruby",
        "variable.other.global.perl",
        "variable.other.readwrite.global.perl",
        "variable.other.predefined.perl"
      ],
      "settings": {
        "foreground": "#b48cff"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template",
        "string.unquoted",
        "markup.inline.raw.string",
        "storage.type.string.python",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Embedded code is code",
      "scope": [
        "string meta.embedded",
        "string meta.template.expression",
        "meta.fstring.python meta.embedded",
        "string.quoted.docstring punctuation"
      ],
      "settings": {
        "foreground": "#ebe6f0"
      }
    },
    {
      "name": "Docstrings are comments",
      "scope": [
        "string.quoted.docstring",
        "string.quoted.docstring punctuation.definition.string",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#9c93ab",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff7b72",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#9c93ab",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#ebe6f0"
      }
    },
    {
      "name": "Heading marks",
      "scope": [
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#9c93ab"
      }
    },
    {
      "name": "Emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strike",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline.markdown string.other.link.title"
      ],
      "settings": {
        "foreground": "#b48cff"
      }
    },
    {
      "name": "Link punctuation",
      "scope": [
        "punctuation.definition.link",
        "punctuation.definition.metadata",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#9c93ab"
      }
    },
    {
      "name": "Inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#ebe6f0"
      }
    },
    {
      "name": "Lists and quotes",
      "scope": [
        "punctuation.definition.list",
        "beginning.punctuation.definition.list",
        "markup.quote",
        "punctuation.definition.quote"
      ],
      "settings": {
        "foreground": "#9c93ab"
      }
    },
    {
      "name": "Fence language",
      "scope": [
        "fenced_code.block.language"
      ],
      "settings": {
        "foreground": "#9c93ab"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#7ee787"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Hunk header",
      "scope": [
        "meta.diff.range",
        "meta.diff.range punctuation"
      ],
      "settings": {
        "foreground": "#b48cff"
      }
    },
    {
      "name": "Diff file",
      "scope": [
        "meta.diff.header",
        "meta.diff.index",
        "meta.separator.diff"
      ],
      "settings": {
        "foreground": "#9c93ab"
      }
    },
    {
      "name": "Commit messages",
      "scope": [
        "meta.scope.message.git-commit"
      ],
      "settings": {
        "foreground": "#ebe6f0"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#ff2d95",
    "modifier": "#ff2d95",
    "decorator": "#ff2d95",
    "macro": "#ff2d95",
    "comment": {
      "foreground": "#9c93ab",
      "italic": true
    },
    "string": "#e5c07b",
    "regexp": "#e5c07b",
    "number": "#b48cff",
    "enumMember": "#b48cff",
    "type": "#b48cff",
    "class": "#b48cff",
    "interface": "#b48cff",
    "enum": "#b48cff",
    "struct": "#b48cff",
    "typeParameter": "#b48cff",
    "typeAlias": "#b48cff",
    "builtinType": "#b48cff",
    "boolean": "#b48cff",
    "selfKeyword": "#b48cff",
    "lifetime": "#b48cff",
    "function.defaultLibrary": "#b48cff",
    "variable.defaultLibrary": "#b48cff",
    "class.defaultLibrary": "#b48cff",
    "namespace.defaultLibrary": "#b48cff",
    "namespace": "#ebe6f0",
    "function": "#ebe6f0",
    "method": "#ebe6f0",
    "variable": "#ebe6f0",
    "variable.readonly": "#ebe6f0",
    "parameter": "#ebe6f0",
    "property": "#ebe6f0",
    "property.readonly": "#ebe6f0",
    "label": "#ebe6f0",
    "operator": "#ebe6f0",
    "event": "#ebe6f0",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
