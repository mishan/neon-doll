# Neon Doll: hot pink neon on midnight plum, for irssi.
# Generated by tools/build-irssi.py; edit that, not this.
#
# Exact colors: /set colors_ansi_24bit on
# Use it:       /set theme neon-doll

default_color = "-1";
info_eol = "false";

replaces = { "[]=" = "%Z6F6880$*%n"; };

abstracts = {
  line_start = "%Z6F6880-%Z9C93AB!%Z6F6880-%n ";
  timestamp = "%Z6F6880$*%n";
  hilight = "%_$*%_";
  error = "%ZFF7B72$*%n";
  channel = "%ZB48CFF$*%n";
  nick = "%_$*%_";
  nickhost = "%Z6F6880[$*%Z6F6880]%n";
  server = "%_$*%_";
  comment = "%Z6F6880[%Z9C93AB$*%Z6F6880]%n";
  reason = "{comment $*}";
  mode = "{comment $*}";
  channick_hilight = "%Z7EE787$*%n";
  chanhost_hilight = "{nickhost %Z6F6880$*}";
  channick = "%Z9C93AB$*%n";
  chanhost = "{nickhost %Z6F6880$*}";
  channelhilight = "%ZB48CFF$*%n";
  ban = "%Z9C93AB$*%n";
  msgnick = "%Z6F6880<%Z9C93AB$0%n$1-%Z6F6880>%n %|";
  ownmsgnick = "{msgnick $0 $1-}";
  ownnick = "%ZB48CFF$*%n";
  pubmsgnick = "{msgnick $0 $1-}";
  pubnick = "$*";
  pubmsgmenick = "{msgnick $0 $1-}";
  menick = "%ZE5C07B%_$*%_%n";
  pubmsghinick = "{msgnick $1 $0$2-%n}";
  msgchannel = "%Z6F6880:%ZB48CFF$*%n";
  privmsg = "%Z6F6880[%ZE5C07B$0%Z6F6880(%Z9C93AB$1-%Z6F6880)%n] ";
  ownprivmsg = "%Z6F6880[%ZB48CFF$0%Z6F6880(%Z9C93AB$1-%Z6F6880)%n] ";
  ownprivmsgnick = "{msgnick  $*}";
  ownprivnick = "%ZB48CFF$*%n";
  privmsgnick = "{msgnick  $*}";
  action_core = "%ZB48CFF*%n %_$*%_";
  action = "{action_core $*} ";
  ownaction = "%ZB48CFF*%n %ZB48CFF$*%n ";
  ownaction_target = "{action_core $0}%Z6F6880:%ZB48CFF$1%n ";
  pvtaction = "%ZB48CFF(*)%n %_$*%_ ";
  pvtaction_query = "{action $*}";
  pubaction = "{action $*}";
  whois = "%# %Z9C93AB$[8]0%n %Z6F6880:%n $1-";
  ownnotice = "%Z6F6880[%ZB48CFF$0%Z6F6880(%Z9C93AB$1-%Z6F6880)]%n ";
  notice = "%Z6F6880-%Z9C93AB$*%Z6F6880-%n ";
  pubnotice_channel = "%Z6F6880:%ZB48CFF$*";
  pvtnotice_host = "%Z6F6880(%Z9C93AB$*%Z6F6880)";
  servernotice = "%Z9C93AB!$*%n ";
  ownctcp = "%Z6F6880[%ZB48CFF$0%Z6F6880(%Z9C93AB$1-%Z6F6880)]%n ";
  ctcp = "%Z9C93AB$*%n";
  wallop = "%_$*%_: ";
  wallop_nick = "%n$*";
  wallop_action = "%ZB48CFF*%n %_$*%_ ";
  netsplit = "%ZFF7B72$*%n";
  netjoin = "%Z7EE787$*%n";
  names_prefix = "";
  names_nick = "%Z6F6880[%Z9C93AB$0%n$1-%Z6F6880]%n ";
  names_nick_op = "{names_nick $*}";
  names_nick_halfop = "{names_nick $*}";
  names_nick_voice = "{names_nick $*}";
  names_users = "%Z6F6880[%Z9C93AB$*%Z6F6880]%n";
  names_channel = "%ZB48CFF$*%n";
  dcc = "%Z9C93AB$*%n";
  dccfile = "%_$*%_";
  dccownmsg = "%Z6F6880[%ZB48CFF$0%Z6F6880(%Z9C93AB$1-%Z6F6880)%n] ";
  dccownnick = "%ZB48CFF$*%n";
  dccownquerynick = "%ZB48CFF$*%n";
  dccownaction = "{action $*}";
  dccownaction_target = "{action_core $0}%Z6F6880:%ZB48CFF$1%n ";
  dccmsg = "%Z6F6880[%ZE5C07B$1-%Z6F6880(%Z9C93AB$0%Z6F6880)%n] ";
  dccquerynick = "%ZE5C07B$*%n";
  dccaction = "%ZB48CFF(*dcc*)%n %_$*%_ %|";
  sb_background = "%z16131D%ZEBE6F0";
  sb_topic_bg = "%z16131D%ZEBE6F0";
  window_border = "%z16131D%Z2A2438";
  sb_prompt_bg = "%n";
  sb_info_bg = "%z16131D%ZEBE6F0";
  sbstart = "";
  sbend = " ";
  topicsbstart = "{sbstart $*}";
  topicsbend = "{sbend $*}";
  prompt = "%Z6F6880[%ZFF2D95$*%Z6F6880]%n ";
  sb = " %Z6F6880[%n$*%Z6F6880]%n";
  sbmode = "%Z6F6880(%ZB48CFF+%n$*%Z6F6880)%n";
  sbaway = " %Z6F6880(%Z9C93ABzZzZ%Z6F6880)%n";
  sbservertag = "%Z6F6880:%n$0 %Z9C93AB(change with ^X)%n";
  sbnickmode = "%Z9C93AB$0%n";
  sb_act_sep = "%Z6F6880$*";
  sb_act_text = "%Z9C93AB$*";
  sb_act_msg = "%ZEBE6F0$*";
  sb_act_hilight = "%ZE5C07B$*";
  sb_act_hilight_color = "$0$1-%n";
};
