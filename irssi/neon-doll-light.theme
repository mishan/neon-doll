# Neon Doll Light: hot pink neon on midnight plum, for irssi.
# Generated by tools/build-irssi.py; edit that, not this.
#
# Exact colors: /set colors_ansi_24bit on
# Use it:       /set theme neon-doll-light

default_color = "-1";
info_eol = "false";

replaces = { "[]=" = "%Z8D84A0$*%n"; };

abstracts = {
  line_start = "%Z8D84A0-%Z5F5670!%Z8D84A0-%n ";
  timestamp = "%Z8D84A0$*%n";
  hilight = "%_$*%_";
  error = "%ZC4312A$*%n";
  channel = "%Z6A3FD0$*%n";
  nick = "%_$*%_";
  nickhost = "%Z8D84A0[$*%Z8D84A0]%n";
  server = "%_$*%_";
  comment = "%Z8D84A0[%Z5F5670$*%Z8D84A0]%n";
  reason = "{comment $*}";
  mode = "{comment $*}";
  channick_hilight = "%Z1F7A33$*%n";
  chanhost_hilight = "{nickhost %Z8D84A0$*}";
  channick = "%Z5F5670$*%n";
  chanhost = "{nickhost %Z8D84A0$*}";
  channelhilight = "%Z6A3FD0$*%n";
  ban = "%Z5F5670$*%n";
  msgnick = "%Z8D84A0<%Z5F5670$0%n$1-%Z8D84A0>%n %|";
  ownmsgnick = "{msgnick $0 $1-}";
  ownnick = "%Z6A3FD0$*%n";
  pubmsgnick = "{msgnick $0 $1-}";
  pubnick = "$*";
  pubmsgmenick = "{msgnick $0 $1-}";
  menick = "%Z8A6100%_$*%_%n";
  pubmsghinick = "{msgnick $1 $0$2-%n}";
  msgchannel = "%Z8D84A0:%Z6A3FD0$*%n";
  privmsg = "%Z8D84A0[%Z8A6100$0%Z8D84A0(%Z5F5670$1-%Z8D84A0)%n] ";
  ownprivmsg = "%Z8D84A0[%Z6A3FD0$0%Z8D84A0(%Z5F5670$1-%Z8D84A0)%n] ";
  ownprivmsgnick = "{msgnick  $*}";
  ownprivnick = "%Z6A3FD0$*%n";
  privmsgnick = "{msgnick  $*}";
  action_core = "%Z6A3FD0*%n %_$*%_";
  action = "{action_core $*} ";
  ownaction = "%Z6A3FD0*%n %Z6A3FD0$*%n ";
  ownaction_target = "{action_core $0}%Z8D84A0:%Z6A3FD0$1%n ";
  pvtaction = "%Z6A3FD0(*)%n %_$*%_ ";
  pvtaction_query = "{action $*}";
  pubaction = "{action $*}";
  whois = "%# %Z5F5670$[8]0%n %Z8D84A0:%n $1-";
  ownnotice = "%Z8D84A0[%Z6A3FD0$0%Z8D84A0(%Z5F5670$1-%Z8D84A0)]%n ";
  notice = "%Z8D84A0-%Z5F5670$*%Z8D84A0-%n ";
  pubnotice_channel = "%Z8D84A0:%Z6A3FD0$*";
  pvtnotice_host = "%Z8D84A0(%Z5F5670$*%Z8D84A0)";
  servernotice = "%Z5F5670!$*%n ";
  ownctcp = "%Z8D84A0[%Z6A3FD0$0%Z8D84A0(%Z5F5670$1-%Z8D84A0)]%n ";
  ctcp = "%Z5F5670$*%n";
  wallop = "%_$*%_: ";
  wallop_nick = "%n$*";
  wallop_action = "%Z6A3FD0*%n %_$*%_ ";
  netsplit = "%ZC4312A$*%n";
  netjoin = "%Z1F7A33$*%n";
  names_prefix = "";
  names_nick = "%Z8D84A0[%Z5F5670$0%n$1-%Z8D84A0]%n ";
  names_nick_op = "{names_nick $*}";
  names_nick_halfop = "{names_nick $*}";
  names_nick_voice = "{names_nick $*}";
  names_users = "%Z8D84A0[%Z5F5670$*%Z8D84A0]%n";
  names_channel = "%Z6A3FD0$*%n";
  dcc = "%Z5F5670$*%n";
  dccfile = "%_$*%_";
  dccownmsg = "%Z8D84A0[%Z6A3FD0$0%Z8D84A0(%Z5F5670$1-%Z8D84A0)%n] ";
  dccownnick = "%Z6A3FD0$*%n";
  dccownquerynick = "%Z6A3FD0$*%n";
  dccownaction = "{action $*}";
  dccownaction_target = "{action_core $0}%Z8D84A0:%Z6A3FD0$1%n ";
  dccmsg = "%Z8D84A0[%Z8A6100$1-%Z8D84A0(%Z5F5670$0%Z8D84A0)%n] ";
  dccquerynick = "%Z8A6100$*%n";
  dccaction = "%Z6A3FD0(*dcc*)%n %_$*%_ %|";
  sb_background = "%zEDE7F3%Z1A1522";
  sb_topic_bg = "%zEDE7F3%Z1A1522";
  window_border = "%zEDE7F3%ZD6CCE2";
  sb_prompt_bg = "%n";
  sb_info_bg = "%zEDE7F3%Z1A1522";
  sbstart = "";
  sbend = " ";
  topicsbstart = "{sbstart $*}";
  topicsbend = "{sbend $*}";
  prompt = "%Z8D84A0[%ZC8006A$*%Z8D84A0]%n ";
  sb = " %Z8D84A0[%n$*%Z8D84A0]%n";
  sbmode = "%Z8D84A0(%Z6A3FD0+%n$*%Z8D84A0)%n";
  sbaway = " %Z8D84A0(%Z5F5670zZzZ%Z8D84A0)%n";
  sbservertag = "%Z8D84A0:%n$0 %Z5F5670(change with ^X)%n";
  sbnickmode = "%Z5F5670$0%n";
  sb_act_sep = "%Z8D84A0$*";
  sb_act_text = "%Z5F5670$*";
  sb_act_msg = "%Z1A1522$*";
  sb_act_hilight = "%Z8A6100$*";
  sb_act_hilight_color = "$0$1-%n";
};
